# Wallhammer Web development image: just Node and pnpm. Sources are mounted from the host,
# dependencies and the pnpm store live in named volumes (see docker-compose.yml next to this file).
FROM node:22.23.5-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=1
RUN corepack enable

# The volume directories must belong to the node user beforehand, otherwise Docker creates them as root.
# Each workspace package has its own node_modules, hence one directory per package (add one line per example).
RUN mkdir -p /app/node_modules \
             /app/packages/wallhammer-web/node_modules \
             /app/examples/destruction/node_modules \
             /app/examples/endless/node_modules \
             /app/examples/fantasy-village/node_modules \
             /app/examples/minimal-3d/node_modules \
             /app/examples/outpost/node_modules \
             /app/examples/planet/node_modules \
             /app/examples/rivers/node_modules \
             /app/examples/shared/node_modules \
             /app/examples/system/node_modules \
             /app/examples/walk/node_modules \
             /pnpm-store \
    && chown -R node:node /app /pnpm-store
WORKDIR /app
USER node
# pnpm goes into the image for the node user, so no container downloads it when it starts.
RUN corepack prepare pnpm@10.34.7 --activate

ENTRYPOINT ["/bin/sh", "/app/scripts/dev-entrypoint.sh"]

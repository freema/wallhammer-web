{
  "name": "wallhammer-web-workspace",
  "private": true,
  "version": "0.8.3",
  "type": "module",
  "license": "MIT",
  "description": "Workspace of the wallhammer-web engine (packages/wallhammer-web), its checks (tools/) and its examples (examples/).",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "check:layers": "node tools/layers/check.ts",
    "check:layers:test": "node tools/layers/test.ts",
    "test:golden": "node tools/golden/engine/golden.ts && node tools/golden/golden.ts",
    "test:golden:engine": "node tools/golden/engine/golden.ts",
    "test:golden:examples": "node tools/golden/golden.ts",
    "check:docs": "node tools/docs/check.ts",
    "check:mesh": "node tools/mesh/check.ts",
    "check:motion": "node tools/motion/check.ts",
    "check:walk": "node tools/walk/check.ts",
    "check:follow": "node tools/follow-check/check.ts",
    "test:marks": "node tools/marks/test.ts",
    "serve": "node tools/serve/serve.ts",
    "build": "pnpm --filter wallhammer-web build",
    "build:examples": "node tools/pages/build.ts",
    "check:pack": "sh tools/pack/check.sh"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.18"
  }
}
